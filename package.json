{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run contracts:build && next dev",
    "build": "npm run contracts:build && next build --webpack",
    "contracts:build": "tsc -p packages/contracts/tsconfig.json",
    "start": "next start",
    "typecheck": "npm run contracts:build && tsc -p tsconfig.json --noEmit",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" next.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" next.config.ts"
  },
  "dependencies": {
    "@doctor-tracker/contracts": "file:packages/contracts",
    "@tanstack/react-query": "^5.107.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
